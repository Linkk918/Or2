#include <stdio.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "driver/ledc.h"
#include "esp_err.h"

// Configuration
#define SERVO_MIN_PULSEWIDTH_US 500  // Minimum pulse width in micro seconds
#define SERVO_MAX_PULSEWIDTH_US 2500 // Maximum pulse width in micro seconds
#define SERVO_MAX_DEGREE        180  // Maximum angle in degrees
#define SERVO_PULSE_GPIO        18   // Change this to your GPIO pin

// LEDC Timer configuration
#define LEDC_TIMER              LEDC_TIMER_0
#define LEDC_MODE               LEDC_LOW_SPEED_MODE
#define LEDC_OUTPUT_IO          (SERVO_PULSE_GPIO) 
#define LEDC_CHANNEL            LEDC_CHANNEL_0
#define LEDC_DUTY_RES           LEDC_TIMER_13_BIT // 2^13 = 8192 counts
#define LEDC_FREQUENCY          50               // 50Hz (20ms period)

// Function to convert angle to duty cycle
static uint32_t servo_per_degree_init(uint32_t degree) {
    uint32_t cal_pulsewidth = (SERVO_MIN_PULSEWIDTH_US + (((SERVO_MAX_PULSEWIDTH_US - SERVO_MIN_PULSEWIDTH_US) * (degree)) / (SERVO_MAX_DEGREE)));
    // Duty = (PulseWidth / Period) * (2^Res - 1)
    // For 50Hz, Period is 20,000us.
    return (uint32_t)((cal_pulsewidth / 20000.0) * 8191);
}

void app_main(void) {
    // 1. Prepare and then apply the LEDC PWM timer configuration
    ledc_timer_config_t ledc_timer = {
        .speed_mode       = LEDC_MODE,
        .timer_num        = LEDC_TIMER,
        .duty_resolution  = LEDC_DUTY_RES,
        .freq_hz          = LEDC_FREQUENCY,
        .clk_cfg          = LEDC_AUTO_CLK
    };
    ESP_ERROR_CHECK(ledc_timer_config(&ledc_timer));

    // 2. Prepare and then apply the LEDC PWM channel configuration
    ledc_channel_config_t ledc_channel = {
        .speed_mode     = LEDC_MODE,
        .channel        = LEDC_CHANNEL,
        .timer_sel      = LEDC_TIMER,
        .intr_type      = LEDC_INTR_DISABLE,
        .gpio_num       = LEDC_OUTPUT_IO,
        .duty           = 0,
        .hpoint         = 0
    };
    ESP_ERROR_CHECK(ledc_channel_config(&ledc_channel));

    while (1) {
        printf("Moving to 0 degrees\n");
        ledc_set_duty(LEDC_MODE, LEDC_CHANNEL, servo_per_degree_init(0));
        ledc_update_duty(LEDC_MODE, LEDC_CHANNEL);
        vTaskDelay(pdMS_TO_TICKS(3000));

        printf("Moving to 90 degrees\n");
        ledc_set_duty(LEDC_MODE, LEDC_CHANNEL, servo_per_degree_init(90));
        ledc_update_duty(LEDC_MODE, LEDC_CHANNEL);
        vTaskDelay(pdMS_TO_TICKS(3000));

        printf("Moving to 180 degrees\n");
        ledc_set_duty(LEDC_MODE, LEDC_CHANNEL, servo_per_degree_init(180));
        ledc_update_duty(LEDC_MODE, LEDC_CHANNEL);
        vTaskDelay(pdMS_TO_TICKS(3000));
    }
}
