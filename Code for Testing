#include <stdio.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "driver/ledc.h"
#include "esp_err.h"

// Servo Pulse Width Settings
#define SERVO_MIN_PULSEWIDTH_US 500  
#define SERVO_MAX_PULSEWIDTH_US 2500 
#define SERVO_MAX_DEGREE        180  

// Define 3 GPIO Pins
#define SERVO_1_GPIO            18   
#define SERVO_2_GPIO            19   
#define SERVO_3_GPIO            21   

#define LEDC_MODE               LEDC_LOW_SPEED_MODE
#define LEDC_TIMER              LEDC_TIMER_0
#define LEDC_DUTY_RES           LEDC_TIMER_13_BIT 
#define LEDC_FREQUENCY          50               

// Helper to calculate duty cycle
static uint32_t calculate_servo_duty(uint32_t degree) {
    uint32_t pulsewidth = (SERVO_MIN_PULSEWIDTH_US + (((SERVO_MAX_PULSEWIDTH_US - SERVO_MIN_PULSEWIDTH_US) * (degree)) / (SERVO_MAX_DEGREE)));
    return (uint32_t)((pulsewidth / 20000.0) * 8191);
}

void app_main(void) {
    // 1. Configure Timer
    ledc_timer_config_t ledc_timer = {
        .speed_mode       = LEDC_MODE,
        .timer_num        = LEDC_TIMER,
        .duty_resolution  = LEDC_DUTY_RES,
        .freq_hz          = LEDC_FREQUENCY,
        .clk_cfg          = LEDC_AUTO_CLK
    };
    ledc_timer_config(&ledc_timer);

    // 2. Configure 3 Channels
    int gpios[3] = {SERVO_1_GPIO, SERVO_2_GPIO, SERVO_3_GPIO};
    ledc_channel_t channels[3] = {LEDC_CHANNEL_0, LEDC_CHANNEL_1, LEDC_CHANNEL_2};

    for (int i = 0; i < 3; i++) {
        ledc_channel_config_t ledc_channel = {
            .speed_mode     = LEDC_MODE,
            .channel        = channels[i],
            .timer_sel      = LEDC_TIMER,
            .intr_type      = LEDC_INTR_DISABLE,
            .gpio_num       = gpios[i],
            .duty           = 0,
            .hpoint         = 0
        };
        ledc_channel_config(&ledc_channel);
    }

    int angles[3] = {0, 90, 180};

    while (1) {
        for (int a = 0; a < 3; a++) {
            printf("Setting all servos to %d degrees...\n", angles[a]);
            
            for (int i = 0; i < 3; i++) {
                ledc_set_duty(LEDC_MODE, channels[i], calculate_servo_duty(angles[a]));
                ledc_update_duty(LEDC_MODE, channels[i]);
                
                // STAGGER DELAY: Wait 200ms between each motor to prevent heat/power spikes
                vTaskDelay(pdMS_TO_TICKS(200)); 
            }

            // WAIT 3 SECONDS before next position
            vTaskDelay(pdMS_TO_TICKS(3000));
        }
    }
}
