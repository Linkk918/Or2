#include <stdio.h>
#include "freertos/FreeRTOS.h"
#include "freertos/task.h"
#include "driver/ledc.h"

// Define 6 GPIO Pins
#define S1_PIN 18   
#define S2_PIN 19   
#define S3_PIN 21   
#define S4_PIN 22   
#define S5_PIN 23   
#define S6_PIN 25   

#define LEDC_MODE               LEDC_LOW_SPEED_MODE
#define LEDC_TIMER              LEDC_TIMER_0
#define LEDC_DUTY_RES           LEDC_TIMER_13_BIT 
#define LEDC_FREQUENCY          50               

static uint32_t calculate_servo_duty(uint32_t degree) {
    uint32_t pulse = (500 + (((2500 - 500) * (degree)) / 180));
    return (uint32_t)((pulse / 20000.0) * 8191);
}

void app_main(void) {
    ledc_timer_config_t timer_cfg = {
        .speed_mode = LEDC_MODE, .timer_num = LEDC_TIMER,
        .duty_resolution = LEDC_DUTY_RES, .freq_hz = LEDC_FREQUENCY, .clk_cfg = LEDC_AUTO_CLK
    };
    ledc_timer_config(&timer_cfg);

    int gpios[6] = {S1_PIN, S2_PIN, S3_PIN, S4_PIN, S5_PIN, S6_PIN};
    ledc_channel_t chans[6] = {LEDC_CHANNEL_0, LEDC_CHANNEL_1, LEDC_CHANNEL_2, LEDC_CHANNEL_3, LEDC_CHANNEL_4, LEDC_CHANNEL_5};

    for (int i = 0; i < 6; i++) {
        ledc_channel_config_t chan_cfg = {
            .speed_mode = LEDC_MODE, .channel = chans[i], .timer_sel = LEDC_TIMER,
            .intr_type = LEDC_INTR_DISABLE, .gpio_num = gpios[i], .duty = 0, .hpoint = 0
        };
        ledc_channel_config(&chan_cfg);
    }

    int pos[3] = {0, 90, 180};
    while (1) {
        for (int p = 0; p < 3; p++) {
            printf("Moving all 6 louvers to %d degrees...\n", pos[p]);
            for (int i = 0; i < 6; i++) {
                ledc_set_duty(LEDC_MODE, chans[i], calculate_servo_duty(pos[p]));
                ledc_update_duty(LEDC_MODE, chans[i]);
                vTaskDelay(pdMS_TO_TICKS(150)); // Staggered start to keep current low
            }
            vTaskDelay(pdMS_TO_TICKS(3000));
        }
    }
}
